# 카카오 API 키 — R-NFR-4.1 · R-NFR-4.3
#
# 이 파일을 `.env.local` 로 복사하고 값을 채운다.
# `.env.local` 은 .gitignore 에 걸려 있어 저장소에 올라가지 않는다.
#
# ⚠ Vite 는 빌드할 때 VITE_ 로 시작하는 값을 결과물에 박아 넣는다.
#   브라우저로 내려가는 키는 감춰지지 않는다 (R-NFR-4.2).
#   지금은 내 컴퓨터에서만 실행하므로 감수한다. 인터넷에 올릴 때는 다시 봐야 한다.
#
# 두 키 모두 없어도 앱은 동작한다. 창구가 직선거리로 어림한 값을 쓴다 (R-NFR-4.5).
#   키가 없을 때  — 장소 검색이 안 되고, 모든 이동 시간이 어림값이다
#   키가 있을 때  — 장소 검색이 되고, 자동차 이동 시간에 실시간 교통이 반영된다

# 카카오 개발자 REST API 키 — 주소↔좌표 · 장소 이름 찾기
VITE_KAKAO_REST_KEY=

# 카카오모빌리티 키 — 자동차 길찾기 (이동 시간)
VITE_KAKAO_MOBILITY_KEY=
